    public void Scores(float Score)
    {
        

        if (rankScore1 < Score)
        {
            rank1.text = " 1. " + "name: " + Name +" / Score: "+ Score.ToString();
            
            return;
        }
        if (rankScore2 < Score)
        {
            rank2.text = " 2. " + "name: " + Name +" / Score: "+Score.ToString();

            return;
        }
        if (rankScore3 < Score)
        {
            rank3.text = " 3. " + "name: " + Name + " / Score: " + Score.ToString();

            return;
        }
        if (rankScore4 < Score)
        {
            rank4.text = " 4. " + "name: " + Name + " / Score: " + Score.ToString();
            return;
        }
        if (rankScore5 < Score)
        {
            rank1.text = " 5. " + "name: " + Name + " / Score: " + Score.ToString();
            return;
        }

    }


public void buy4()
{
    if (money >= price4)
    {
        money -= price4;
      
        buybutton4.interactable = false;

        Debug.Log("구매완료");
        equipped4.SetActive(true);
    }
    else
    {   
        Debug.Log("돈 부족");
    }
}

}

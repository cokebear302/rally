    public void GameClear(Boss.shootType type)
    {
        StartCoroutine(ClearStageCoroutine());

        if (type == Boss.shootType.Boss1)
        {
            a += Score;
            GameClearMessage.text = "STAGE1-CLEAR!";
            Score = 0;
            Main.SetActive(true);
            Stage1.SetActive(false);
            isTime = false;
            inGame.SetActive(false);
        }

        else if (type == Boss.shootType.Boss2)
        {
            a += Score;
            GameClearMessage.text = "STAGE2-CLEAR!";
            Score = 0;
            Main.SetActive(true);
            Stage2.SetActive(false);
            isTime = false;
            inGame.SetActive(false);
        }
            
        else if (type == Boss.shootType.Boss3)
        {
            a += Score;
            GameClearMessage.text = "STAGE3-CLEAR!";
            Score = 0;
            Main.SetActive(true);
            Nickname.SetActive(true);
            Stage3.SetActive(false);
            
            isTime = false;
            inGame.SetActive(false);
            outGame.SetActive(false);
            Scores(a);
        }
  
    }

    IEnumerator ClearStageCoroutine()
    {
        GameClearPanel.SetActive(true);
        yield return new WaitForSeconds(2f);
        GameClearPanel.SetActive(false);
    }

    public void UnLockStage(Boss.shootType type)
    {
        if (type == Boss.shootType.Boss1)
        {
            stage2unlock = true;
            if (unlock1 != null)
            {
                unlock1.SetActive(false);
            }

        }
        if (type == Boss.shootType.Boss2)
        {
            stage3unlock = true;
            if (unlock2 != null)
            {
                unlock2.SetActive(false);
            }
        }
    }
    
    public void unlockStage1()

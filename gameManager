        }

        // 디버그 모드일 때만 실행

        if (Input.GetKeyDown(KeyCode.F8))
        {
            Debug.Log("치트 2 ON");
            cantakeDamage = true;
            cheatText.text = "치트 2";
            cheatText2.text = "플레이어 피격 면역 상태 ON";
            StartCoroutine(messageInfo());
        }
        if (Input.GetKeyDown(KeyCode.F9))
        {
            Debug.Log("치트 2 OFF");
            cantakeDamage = false;
            cheatText.text = "치트 2";
            cheatText2.text = "플레이어 피격 면역 상태 OFF";
            StartCoroutine(messageInfo());
        }
        if (Input.GetKeyDown(KeyCode.F10))
        {
            enemyallKill = true;
            Debug.Log("치트 3");
            cheatText.text = "치트 3";
            cheatText2.text = "강제 적 사망";
            StartCoroutine(messageInfo());

        }
        if (Input.GetKeyDown(KeyCode.F11))
        {
            Player p = GetComponent<Player>();
            Debug.Log("치트 4");
            cheatText.text = "치트 4";
            cheatText2.text = "1000 파편(골드) 획득";
            Money += 1000;
            StartCoroutine(messageInfo());
        }

        // 파츠 스킬

        if (Input.GetKeyDown(KeyCode.F1))
        {
            if (onInf == true)
            {
                StartCoroutine(Myskill());
            }

        }
        if (Input.GetKeyDown(KeyCode.F2))
        {
            if (onblackHoll == true)
            {
                StartCoroutine(Myskil2());

            }

        }
        if (Input.GetKeyDown(KeyCode.F3))
        {

            if (onSlow == true)
            {
                StartCoroutine(Myskill3());
            }

        }
        if (Input.GetKeyDown(KeyCode.F4))
        {
            if (ontimeStop == true)
            {
                StartCoroutine(Myskill4());
            }

        }
        if (Input.GetKeyDown(KeyCode.F5))
        {
            if (onShild == true)
            {
                StartCoroutine(Myskill5());
            }
        }
        if (Input.GetKeyDown(KeyCode.E))
        {
            if (Hppotion >= 1)
            {
                useItemHpPotion();
                Hppotion -= 1;
                HppotionEffect.SetActive(true);
                audioSource.clip = clip[3];
                audioSource.Play();
            }
            else
            {
                cheatText.text = "회복 포션";
                cheatText2.text = "회복 포션의 갯수가 부족합니다";
                StartCoroutine(messageInfo());
            }
        }
        if (Input.GetKeyDown(KeyCode.Q))
        {
            if (bomb >= 1)
            {
                useBomb = true;
                BombText.text = "폭탄 - " + bomb.ToString();
                bomb -= 1;
                BombEffect.gameObject.SetActive(true);
                StartCoroutine(BombCount());
            }
            else
            {
                cheatText.text = "폭탄";
                cheatText2.text = "소지한 폭탄 아이템의 갯수가 부족합니다";
                StartCoroutine(messageInfo());
            }
        }
        if (Input.GetKeyDown(KeyCode.R))
        {
            if (Infitem >= 1)
            {

                StartCoroutine(INF());
                Infitem -= 1;
                InfText.text = "HP물약 - " + Infitem.ToString();
            }
            else
            {
                cheatText.text = "무적";
                cheatText2.text = "소지한 무적 아이템의 갯수가 부족합니다";
                StartCoroutine(messageInfo());
            }
        }
    } 
    public void useItemHpPotion()
    {
        p.Hp += 50;
        HppotionText.text = "HP물약 - " + Hppotion.ToString();
        if (p.Hp > p.MaxHp)
        {
            p.Hp = p.MaxHp;

        }
    }

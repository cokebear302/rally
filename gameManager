    [ContextMenu("test")]
    

    private void Update()
    {

        if (isTime == true)
        {
        Score += Time.deltaTime;
        ScoreText.text = Mathf.FloorToInt(Score / 60).ToString() + ":" + Mathf.FloorToInt(Score % 60).ToString();
        }

        moneyText.text = Money.ToString();
        if (Input.GetKeyDown(KeyCode.F6))

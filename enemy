public class Enemy : MonoBehaviour
{
    private Rigidbody rb;

    public GameObject missilePrefab;
    public Transform firePoint;
    public Transform Player;
    
    public float killMoney = 20;

    public Slider Hpbar;

    public shootType ShootType;

    public bool isGround = false;

    bool isShooting = false;
    public float shootCooldown = 4f;
    float shootTimer = 2f;
    public float detectDistance = 100f;

   

    public int Hp = 20;

    public float Speed = 1f;
    public float RotateSpeed = 10f;

    public float singleSpeed = 2f;
    public float tripleSpeed = 2f;
    public float shotgunSpeed = 3f;
    public float speedgunSpeed = 30f;
    public float PredictBomb = 3f;
    public enum shootType
    {
        Single,
        Triple,
        Shotgun,
        Speedgun,
        Bomb,
        
    }

    
    void Start()
    {
        rb = GetComponent<Rigidbody>();


    }

    // Update is called once per frame
    void Update()
    {
        
            
        if (GameManager.Instance.enemyDie == false)
        {
            gameObject.SetActive(true);
        }
        else if (GameManager.Instance.enemyDie == true)
        {
            gameObject.SetActive(false);
        }

        
        if (Player == null) return;

        float dist = Vector3.Distance(transform.position, Player.position);

        shootTimer -= Time.deltaTime;

        if (dist < detectDistance)
        {
            Vector3 lookPos = Player.position - transform.position;
            lookPos.y = 0;

            Quaternion rot = Quaternion.LookRotation(lookPos);
            transform.rotation = Quaternion.Lerp(transform.rotation, rot, 3f * Time.deltaTime);

            if (shootTimer <= 0 && !isShooting)
            {
                Shoot();
                
                shootTimer = shootCooldown;
                
            }
            
        }

        //if (Player != null)
        //{
        //    Vector3 dis = Player.position - transform.position;

        //    Quaternion disRotate = Quaternion.LookRotation(dis);
        //    transform.rotation = Quaternion.Lerp(transform.rotation, disRotate, RotateSpeed * Time.deltaTime);
        //}

        //transform.position = transform.forward * Speed * Time.deltaTime;
        
        Die();
        CheckallDemge(Hp);
       if (isGround == false)
        {
            //Retuning();
        }


    }

    
    public void CheckallDemge(int demge)
    {
        if (GameManager.Instance.enemyallKill == true)
        {
            Hp = 0;
        }
    }

    public void Shoot()
    {
        if (missilePrefab == null || firePoint == null) return;

        switch (ShootType)
        {
            case shootType.Single:
                
                shootSingl();
                break;
            case shootType.Triple:
                
                StartCoroutine(ShootTriple());
                break;
            case shootType.Shotgun:
                
                Shotgun();
                break;
            case shootType.Speedgun:
                
                speedGun();
                break;
            case shootType.Bomb:
                
                StartCoroutine(CoutineBomb());
                break;
        }
    }

    void shootSingl()
    {
        GameObject missile = Instantiate(missilePrefab, firePoint.position, firePoint.rotation);

        Missle m = missile.GetComponent<Missle>();
        if (m != null)
        {
            m.speed = tripleSpeed;
            m.target = Player;
        }
        
    }
    
    IEnumerator ShootTriple()
    {
        isShooting = true;

        for (int i = 0; i < 3; i++)
        {
            GameObject missile = Instantiate(missilePrefab, firePoint.position, firePoint.rotation);

            Missle m = missile.GetComponent<Missle>();
            if (m != null)
            {
                m.speed = tripleSpeed;
                m.target = Player;
            }

            yield return new WaitForSeconds(0.3f);

        }

        isShooting = false;
        
    }

    void Shotgun()
    {
        
        int bulletCount = 5;
        float spread = 100f;

        for (int i = 0;i < bulletCount;i++)
        {
            float angle = spread * (i - (bulletCount - 1) / 2f);

            Quaternion rot = firePoint.rotation * Quaternion.Euler(0, angle, 0);

            GameObject missile = Instantiate(missilePrefab, firePoint.position, rot);

            Missle m = missile.GetComponent <Missle>();
            if (m != null)
            {
                m.speed = shotgunSpeed;
                m.target = Player;
            }
            
        }
    }

    void speedGun()
    {

        GameObject missile = Instantiate(missilePrefab, firePoint.position, firePoint.rotation);

        Missle m = missile.GetComponent<Missle>();
        if (m != null)
        {
            m.rotateSpeed = 0;
            m.speed = speedgunSpeed;
            m.target = Player;
        }
    }

    IEnumerator CoutineBomb()
    {
        isShooting = true;
        int bulletCount = 10;
        int spread = 100;

        for (int i = 0; i < bulletCount; i++)
        {
            float angle = spread * (i - (bulletCount - 1) / 2f);
            Quaternion rot = firePoint.rotation * Quaternion.Euler(0, angle, 0);
            GameObject missile = Instantiate(missilePrefab, firePoint.position, rot);

            Missle m = missile.GetComponent<Missle>();
            if (m != null)
            {
                m.rotateSpeed = 0.5f;
                m.speed = tripleSpeed;
                m.target = Player;
            }

            yield return new WaitForSeconds(0.01f);
        }
        
        isShooting = false;
        Hp -= 10;
    }



    public void TakeDemge(int damge)
    {
        Hp -= damge;

        if (Hp <= 0)
        {
            Hp = 0;
        }
    }

    public void Die()
    {
        if (Hp == 0)
        {      
            GameManager.Instance.Money += 20;
            Destroy(gameObject);
        }
    }
}
